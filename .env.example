# Application Settings
APP_NAME="Claude Nightcrawler"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# Database Configuration
DB_PATH="agent.db"
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24

# Dashboard Configuration
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT=8000
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_PASSWORD_IMMEDIATELY"  # bcrypt hashed in production

# Domain Configuration (for production)
DOMAIN_NAME="your-subdomain.duckdns.org"
DUCKDNS_TOKEN="your-duckdns-token"

# Claude Configuration
CLAUDE_URL="https://claude.ai"
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT=30000  # milliseconds
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Task Management
TASK_POLL_INTERVAL=10  # seconds
TASK_COMPLETION_WAIT=2  # seconds between tasks
MAX_CONCURRENT_TASKS=1  # always 1 for free tier

# Limit Detection
LIMIT_CHECK_INTERVAL=30  # seconds
DEFAULT_LIMIT_WAIT_HOURS=5  # fallback if time not detected

# Logging Configuration
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_MAX_SIZE_MB=5
LOG_BACKUP_COUNT=3
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Telegram Notifications (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFY_ON_COMPLETE=true
TELEGRAM_NOTIFY_ON_LIMIT=true
TELEGRAM_NOTIFY_ON_ERROR=true

# Security Settings
SESSION_SECRET_KEY="generate-random-secret-key-here"  # openssl rand -hex 32
CORS_ORIGINS="*"  # Comma-separated, or * for development
RATE_LIMIT_PER_MINUTE=60

# Maintenance
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300  # seconds
AUTO_CLEANUP_OLD_TASKS_DAYS=30

# Browser Data
BROWSER_DATA_DIR="browser_data"
RESULTS_DIR="results"
LOGS_DIR="logs"
