# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Claude Nightcrawler — Caddyfile                                         ║
# ║  Automatic HTTPS (Let's Encrypt) + Reverse Proxy → FastAPI :8000         ║
# ║                                                                          ║
# ║  Replace YOUR_DOMAIN with your DuckDNS subdomain, e.g.:                 ║
# ║    your-agent.duckdns.org                                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝

{
    # Global options block
    # Set your contact email for Let's Encrypt certificate notifications
    email admin@example.com

    # Enable debug logging during initial setup, then comment out
    # debug

    # Default HTTPS port (443) — don't change
    https_port 443
    http_port  80
}

# ── Site block ─────────────────────────────────────────────────────────────
# Caddy automatically provisions and renews a Let's Encrypt certificate
YOUR_DOMAIN {
    # ── Logging ──────────────────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 720h
        }
        format json
    }

    # ── Security headers ─────────────────────────────────────────────────
    header {
        # Enable HSTS (1 year, includes subdomains, preload)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Block MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions policy: restrict sensitive APIs
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Remove server identification header
        -Server
    }

    # ── Rate limiting ────────────────────────────────────────────────────
    # Protects against brute-force login attempts (requires Caddy Enterprise
    # or the rate_limit plugin; remove if using standard Caddy binary)
    # rate_limit {
    #     zone dynamic {
    #         key {remote_host}
    #         events 60
    #         window 1m
    #     }
    # }

    # ── Compression ──────────────────────────────────────────────────────
    encode gzip zstd

    # ── Static files (served directly by Caddy for performance) ──────────
    # Uncomment to serve static files directly (avoids FastAPI overhead):
    # handle /static/* {
    #     root * /opt/claude-agent
    #     file_server
    # }

    # ── Reverse proxy → FastAPI dashboard ────────────────────────────────
    reverse_proxy 127.0.0.1:8000 {
        # Pass real client IP to the app
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check — Caddy will stop routing to the backend if /health fails
        health_uri /health
        health_interval 30s
        health_timeout  5s
        health_status   200

        # Timeouts (long timeout for LLM responses which can take minutes)
        transport http {
            dial_timeout       10s
            response_header_timeout 600s
            read_buffer_size   16kb
            write_buffer_size  16kb
        }
    }
}

# ── HTTP → HTTPS redirect (Caddy does this automatically for sites
#    declared with a domain name, but explicit for clarity) ─────────────────
# http://YOUR_DOMAIN {
#     redir https://{host}{uri} permanent
# }
