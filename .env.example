# ============================================================================
#  Claude Nightcrawler - Environment Configuration
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#    nano .env
#
#  IMPORTANT: Keep .env secret -- never commit it to git!
#  Set permissions: chmod 600 .env
# ============================================================================

# -- Authentication -----------------------------------------------------------
# Username and password for the web dashboard (HTTP Basic Auth)
# Password can be a bcrypt hash (recommended) or plain text.
#
# To generate a bcrypt hash (recommended for production):
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt()).decode())"
#
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-use-a-strong-password"

# -- Network / Domain ---------------------------------------------------------
# Your DuckDNS subdomain -- full domain with .duckdns.org suffix
# Example: my-claude-agent.duckdns.org
DOMAIN_NAME="your-agent.duckdns.org"

# Just the subdomain part (without .duckdns.org)
# Example: my-claude-agent
DUCKDNS_DOMAIN="your-agent"

# Your DuckDNS API token (shown at the top of duckdns.org after login)
DUCKDNS_TOKEN="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# -- File Paths ---------------------------------------------------------------
# These default to paths under the installation directory.
# Only change if you want a custom layout.

# Path to the SQLite database file
DB_PATH="/opt/claude-agent/data/nightcrawler.db"

# Directory where Claude response Markdown files are saved
RESULTS_DIR="/opt/claude-agent/results"

# Directory for Playwright persistent browser profile (contains session cookies)
BROWSER_DATA_DIR="/opt/claude-agent/browser_data"

# Directory for log files
LOGS_DIR="/opt/claude-agent/logs"

# -- Telegram Notifications (Optional) ----------------------------------------
# Leave blank to disable all Telegram notifications.
#
# How to set up:
#   1. Message @BotFather on Telegram -> /newbot -> get token
#   2. Start a chat with your new bot
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates to find chat_id
#
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Individual notification toggles (only used if bot token is set)
TELEGRAM_NOTIFY_ON_COMPLETE="true"
TELEGRAM_NOTIFY_ON_LIMIT="true"
TELEGRAM_NOTIFY_ON_ERROR="true"

# -- Worker Tuning ------------------------------------------------------------
# How often the worker checks for new tasks when the queue is empty (seconds)
POLL_INTERVAL="10"

# How long to pause between consecutive tasks (seconds)
BETWEEN_TASK_WAIT="3"

# Base delay for exponential backoff on errors (seconds)
# Actual delay = base * 2^retry_count + jitter, capped at 120s
RETRY_BASE_DELAY="5"

# Maximum number of retry attempts before marking a task as failed
MAX_RETRIES="3"

# How often the worker polls while waiting for a rate limit to reset (seconds)
LIMIT_CHECK_INTERVAL="60"
